{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "warehouse-tycoon",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "projects/warehouse-tycoon",
        "run",
        "dev",
        "--",
        "--port",
        "5187",
        "--strictPort"
      ],
      "port": 5187
    },
    {
      "name": "museum",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5191",
        "--bind",
        "::",
        "--directory",
        "projects/museum"
      ],
      "port": 5191
    }
  ]
}